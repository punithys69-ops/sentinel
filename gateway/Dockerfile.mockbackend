FROM golang:1.23-alpine AS builder
ENV GOTOOLCHAIN=auto
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o mockbackend ./mock-backend

FROM alpine:3.20
RUN adduser -D -u 1000 sentinel
USER sentinel
WORKDIR /app
COPY --from=builder /build/mockbackend .
EXPOSE 9001
ENTRYPOINT ["./mockbackend"]
